{
  "info": {
    "name": "FuelRoute Demo",
    "_postman_id": "d9b7f3b4-7c3a-4f2b-9b7a-1a2c3d4e5f60",
    "description": "Example requests for the FuelRoute API (use {{baseUrl}} environment variable).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Route - Basic (addresses)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/route/?start=New+York,NY&end=Boston,MA",
          "query": [
            {"key":"start","value":"New York,NY"},
            {"key":"end","value":"Boston,MA"}
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response has route', function () { var j = pm.response.json(); pm.expect(j).to.have.property('route'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Route - Coords + preset",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/route/?start=40.7128,-74.0060&end=42.3601,-71.0589&preset=car" }
      },
      "event": [
        {
          "listen": "test",
          "script": {"type":"text/javascript","exec":["pm.test('200', function(){pm.response.to.have.status(200)});","pm.test('Has fuel_stops or summary', function(){var j=pm.response.json();pm.expect(j).to.have.property('summary');});"]}
        }
      ]
    },
    {
      "name": "Route - Avoid tolls & highways",
      "request": {"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/route/?start=Los+Angeles,CA&end=San+Francisco,CA&avoid_tolls=1&avoid_highways=1"}},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200 or handled error', function(){pm.response.to.be.ok;});"]}}]
    },
    {
      "name": "Route - Custom tank & mpg",
      "request": {"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/route/?start=Houston,TX&end=Miami,FL&tank_range=600&mpg=15"}},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('Status 200', function(){pm.response.to.have.status(200)});","pm.test('Has summary', function(){pm.expect(pm.response.json()).to.have.property('summary');});"]}}]
    },
    {
      "name": "Route - Map (HTML)",
      "request": {"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/route/map/?start=Seattle,WA&end=Portland,OR"}},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200', function(){pm.response.to.have.status(200)});","pm.test('Content-Type is html', function(){pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html');});"]}}]
    },
    {
      "name": "Place search (autocomplete)",
      "request": {"method":"GET","header":[],"url":{"raw":"{{baseUrl}}/api/search/?q=Chicago"}},
      "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('200', function(){pm.response.to.have.status(200)});","pm.test('Returns array', function(){var j=pm.response.json();pm.expect(Array.isArray(j)).to.be.true;});"]}}]
    }
  ],
  "event": [],
  "variable": [
    {"key":"baseUrl","value":"http://127.0.0.1:8000","type":"string"}
  ]
}
