# Copy this file to .env and fill in the values

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*

# External services (defaults work out of the box)
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Must be a valid contact email or app name per Nominatim ToS
NOMINATIM_USER_AGENT=fuel-route-api/1.0 (your@email.com)

# How far (miles) from the route polyline a station can be and still be considered
STATION_ROUTE_PROXIMITY_MILES=5.0
